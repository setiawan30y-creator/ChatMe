# =====================================================================
#  Almara Chat (ChatMe) — konfigurasi lingkungan
#  @2026-Alifiandra
# =====================================================================

APP_NAME="Almara Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laragon: http://chatme.test  (aktifkan SSL agar PWA bisa di-install: https://chatme.test)
APP_URL=http://chatme.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL Laragon) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatme
DB_USERNAME=root
DB_PASSWORD=

# Sesi panjang agar PWA tetap masuk (menit). Perangkat tetap bisa dicabut dari jarak jauh.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Real-time (Laravel Reverb) ---
# Jalankan: php artisan reverb:start
# Jika Reverb tidak berjalan, aplikasi otomatis memakai sinkronisasi berkala.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=chatme
REVERB_APP_KEY=chatme-key
REVERB_APP_SECRET=chatme-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Alamat Reverb yang dipakai browser. Kosongkan REVERB_PUBLIC_HOST = pakai domain halaman (mis. chatme.test).
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

# --- OTP ---
# log  : kode OTP ditulis di storage/logs/laravel.log (dan tampil di layar saat OTP_SHOW_IN_RESPONSE=true)
# http : kirim lewat WhatsApp/SMS gateway Anda -> POST JSON {phone, message, code} + Bearer token
OTP_DRIVER=log
OTP_SHOW_IN_RESPONSE=true
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_HTTP_URL=
OTP_HTTP_TOKEN=

# --- Batas aplikasi ---
CHATME_COUNTRY_CODE=62
CHATME_MAX_DEVICES=5
CHATME_MAX_UPLOAD_KB=20480
CHATME_GROUP_MAX_MEMBERS=256

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
